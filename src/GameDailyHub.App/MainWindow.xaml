<Window x:Class="GameDailyHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GameDailyHub">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="GoBack_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="GoForward_Invoked"/>
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Visible" IsBackEnabled="False" BackRequested="Navigation_BackRequested" PaneDisplayMode="Auto" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="760" OpenPaneLength="220" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneCustomContent>
                <Grid Height="48" Margin="12,4,12,16" Visibility="{x:Bind Navigation.IsPaneOpen, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="24" Height="24" AutomationProperties.Name="GameDailyHub 图标"/>
                    <TextBlock Grid.Column="2" Text="GameDailyHub" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="总览" Tag="home" Icon="Home"/>
                <NavigationViewItem Content="任务队列" Tag="tasks" Icon="List"/>
                <NavigationViewItem Content="游戏" Tag="config" Icon="Setting"/>
                <NavigationViewItem Content="日志" Tag="logs" Icon="Document"/>
                <NavigationViewItem Content="定时" Tag="schedule" Icon="Clock"/>
            </NavigationView.MenuItems>
            <Grid Padding="28,12,28,20" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=TwoWay}" Severity="Informational" Message="{x:Bind ViewModel.Message, Mode=OneWay}"/>
                <Frame x:Name="ContentFrame" Grid.Row="1" CacheSize="6" Navigated="ContentFrame_Navigated" NavigationFailed="ContentFrame_NavigationFailed">
                    <Frame.ContentTransitions>
                        <TransitionCollection><NavigationThemeTransition/></TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
