<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>GameDailyHub.App</RootNamespace><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HubUiTest)' == 'true'">
    <ApplicationManifest>app.test.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);HUB_UI_TEST</DefineConstants>
    <IntermediateOutputPath>obj\ui-test\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\ui-test\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <ProjectReference Include="../GameDailyHub.Windows/GameDailyHub.Windows.csproj"/>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1"/>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
  </ItemGroup>
  <!-- Unpackaged SDK Publish does not always include project PRI/XBF output. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI 项目 PRI 尚未生成，请先完成构建。"/>
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_GameDailyHubXbf Include="$(TargetDir)**\*.xbf"/>
      <ResolvedFileToPublish Include="@(_GameDailyHubXbf)">
        <RelativePath>%(_GameDailyHubXbf.RecursiveDir)%(_GameDailyHubXbf.Filename)%(_GameDailyHubXbf.Extension)</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
