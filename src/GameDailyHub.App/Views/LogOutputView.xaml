<UserControl x:Class="GameDailyHub.App.Views.LogOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="10" CornerRadius="6" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <TextBlock x:Name="OutputText" Margin="0,0,12,0" FontFamily="Consolas" FontSize="12"
                TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </ScrollViewer>
    </Border>
</UserControl>
