<Application x:Class="GameDailyHub.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GameDailyHub.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <views:EnumLabelConverter x:Key="EnumLabel"/>
            <DataTemplate x:Key="EnumTemplate"><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/></DataTemplate>
            <Style TargetType="TextBox"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>